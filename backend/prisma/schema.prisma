generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Admin {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  username  String?  @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admins")
}

model SiteSettings {
  id                Int      @id @default(1)
  primaryColor      String   @default("#3B82F6")
  fontFamily        String   @default("Inter")
  headingFontFamily String   @default("Inter")
  logoUrl           String?
  faviconUrl        String?
  resumeUrl         String?
  avatarUrl         String?
  githubUrl         String?
  linkedinUrl       String?
  twitterUrl        String?
  emailContact      String?

  // Multilingual Profile/Bio fields
  fullNameAr        String   @default("")
  fullNameEn        String   @default("")
  fullNameTr        String   @default("")

  jobTitleAr        String   @default("")
  jobTitleEn        String   @default("")
  jobTitleTr        String   @default("")

  bioAr             String   @db.Text
  bioEn             String   @db.Text
  bioTr             String   @db.Text

  aboutTextAr       String   @db.Text
  aboutTextEn       String   @db.Text
  aboutTextTr       String   @db.Text

  aboutParagraph2Ar String?  @db.Text
  aboutParagraph2En String?  @db.Text
  aboutParagraph2Tr String?  @db.Text

  // Profile & Hero (Enterprise CMS additions)
  displayNameAr        String   @default("")
  displayNameEn        String   @default("")
  displayNameTr        String   @default("")

  heroHeadlineAr       String   @default("")
  heroHeadlineEn       String   @default("")
  heroHeadlineTr       String   @default("")

  availabilityStatusAr String   @default("")
  availabilityStatusEn String   @default("")
  availabilityStatusTr String   @default("")

  locationAr           String   @default("")
  locationEn           String   @default("")
  locationTr           String   @default("")

  profilePhotoUrl      String?
  contactEmail         String?

  // Section Headings Copywriting (badge, title, subtitle across Ar/En/Tr)
  sectionCopywriting   Json?

  // SEO Hub
  siteName             String   @default("Portfolio")
  canonicalUrl         String?
  defaultTitle         String   @default("Portfolio")
  metaDescription      String?  @db.Text
  titleTemplate        String   @default("%s | Portfolio")
  robotsDirectives     String   @default("index, follow")
  keywords             String   @default("")

  updatedAt            DateTime @updatedAt

  @@map("site_settings")
}

model Project {
  id            Int      @id @default(autoincrement())
  titleAr       String   @default("")
  titleEn       String   @default("")
  titleTr       String   @default("")
  descriptionAr String   @db.Text
  descriptionEn String   @db.Text
  descriptionTr String   @db.Text
  imageUrl      String
  liveUrl       String?
  githubUrl     String?
  tags          Json
  isFeatured    Boolean  @default(false)
  orderIndex    Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("projects")
}

model Skill {
  id           Int      @id @default(autoincrement())
  name         String
  category     String
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("skills")
}

model Message {
  id          Int      @id @default(autoincrement())
  senderName  String
  senderEmail String
  subject     String?
  messageBody String   @db.Text
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@map("messages")
}

model WorkflowStep {
  id            Int      @id @default(autoincrement())
  stepNumber    Int
  titleAr       String   @default("")
  titleEn       String   @default("")
  titleTr       String   @default("")
  descriptionAr String   @db.Text
  descriptionEn String   @db.Text
  descriptionTr String   @db.Text
  orderIndex    Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("workflow_steps")
}

model Experience {
  id                     Int      @id @default(autoincrement())
  type                   String
  degreeOrRoleAr         String   @default("")
  degreeOrRoleEn         String   @default("")
  degreeOrRoleTr         String   @default("")
  institutionOrCompanyAr String   @default("")
  institutionOrCompanyEn String   @default("")
  institutionOrCompanyTr String   @default("")
  startDate              String   @default("")
  endDate                String?
  locationAr             String   @default("")
  locationEn             String   @default("")
  locationTr             String   @default("")
  icon                   String?
  nodeColor              String   @default("#3B82F6")
  descriptionAr          String   @db.Text
  descriptionEn          String   @db.Text
  descriptionTr          String   @db.Text
  orderIndex             Int      @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@map("experiences")
}

model Service {
  id            Int      @id @default(autoincrement())
  serviceNumber String   @default("")
  titleAr       String   @default("")
  titleEn       String   @default("")
  titleTr       String   @default("")
  descriptionAr String   @db.Text
  descriptionEn String   @db.Text
  descriptionTr String   @db.Text
  icon          String?
  isActive      Boolean  @default(true)
  orderIndex    Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("services")
}

model Faq {
  id          Int      @id @default(autoincrement())
  category    String   @default("Services & Scope")
  questionAr  String   @default("")
  questionEn  String   @default("")
  questionTr  String   @default("")
  answerAr    String   @db.Text
  answerEn    String   @db.Text
  answerTr    String   @db.Text
  isPublished Boolean  @default(true)
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("faqs")
}

model SocialLink {
  id         Int      @id @default(autoincrement())
  platform   String
  url        String
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("social_links")
}

model TranslationKey {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  valueAr   String   @db.Text
  valueEn   String   @db.Text
  valueTr   String   @db.Text
  category  String   @default("general")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("translation_keys")
}

model Certificate {
  id            Int      @id @default(autoincrement())
  titleAr       String   @default("")
  titleEn       String   @default("")
  titleTr       String   @default("")
  issuer        String
  issueDate     String
  credentialUrl String?
  imageUrl      String?
  orderIndex    Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("certificates")
}